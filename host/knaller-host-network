#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:?Action required}"

CONFIG="${KNALLER_CONFIG:-/etc/knaller/config.yaml}"
KNALLER_BIN="${KNALLER_BIN:-/usr/local/bin/knaller}"

case "$ACTION" in
	start)
		exec "$KNALLER_BIN" network ensure-host --config "$CONFIG"
		;;
	stop)
		exec "$KNALLER_BIN" network teardown-host --config "$CONFIG"
		;;
	restart)
		"$KNALLER_BIN" network teardown-host --config "$CONFIG" || true
		exec "$KNALLER_BIN" network ensure-host --config "$CONFIG"
		;;
	status)
		echo "=== knaller host network ==="
		echo "config: $CONFIG"
		sysctl net.ipv4.ip_forward 2>/dev/null || true
		echo
		nft list table inet knaller_filter 2>/dev/null || true
		echo
		nft list table ip knaller_nat 2>/dev/null || true
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}" >&2
		exit 2
		;;
esac
