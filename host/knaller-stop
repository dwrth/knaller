#!/usr/bin/env bash
set -euo pipefail

ID="${1:?sandbox id required}"

JAILER_BASE="${KNALLER_JAILER_BASE:-/srv/jailer}"
ROOT="$JAILER_BASE/firecracker/$ID/root"
SOCKET="$ROOT/run/firecracker.socket"
PIDFILE="$ROOT/firecracker.pid"

if [[ ! -S "$SOCKET" ]]; then
	echo "No API socket for $ID"
	exit 0
fi

PID=""
if [[ -f "$PIDFILE" ]]; then
	PID="$(tr -d '[:space:]' <"$PIDFILE" || true)"
fi

echo "Requesting graceful shutdown of $ID"

curl \
	--silent \
	--show-error \
	--fail \
	--noproxy '*' \
	--unix-socket "$SOCKET" \
	-X PUT \
	-H 'Content-Type: application/json' \
	-d '{"action_type":"SendCtrlAltDel"}' \
	http://localhost/actions \
	>/dev/null || true

if [[ -n "$PID" ]]; then
	for _ in $(seq 1 100); do
		if ! kill -0 "$PID" 2>/dev/null; then
			echo "$ID stopped"
			exit 0
		fi
		sleep 0.1
	done
fi

# Soft success for systemd ExecStop; Go Stop returns ErrStillRunning for CLI.
echo "$ID did not exit after graceful shutdown request"
exit 0
