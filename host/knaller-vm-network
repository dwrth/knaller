#!/usr/bin/env bash
set -euo pipefail

ID="${1:?sandbox id required}"
ACTION="${2:?Action required}"

CONFIG="${KNALLER_CONFIG:-/etc/knaller/config.yaml}"
KNALLER_BIN="${KNALLER_BIN:-/usr/local/bin/knaller}"

case "$ACTION" in
	start)
		exec "$KNALLER_BIN" network setup --config "$CONFIG" "$ID"
		;;
	stop)
		exec "$KNALLER_BIN" network teardown --config "$CONFIG" "$ID"
		;;
	restart)
		"$KNALLER_BIN" network teardown --config "$CONFIG" "$ID" || true
		exec "$KNALLER_BIN" network setup --config "$CONFIG" "$ID"
		;;
	status)
		exec "$KNALLER_BIN" network status --config "$CONFIG" "$ID"
		;;
	*)
		echo "Usage: $0 <sandbox-id> {start|stop|restart|status}" >&2
		exit 2
		;;
esac
