#!/usr/bin/env bash
set -euo pipefail

ID="${1:?sandbox id required}"

STATE_DIR="${KNALLER_STATE_DIR:-/var/lib/knaller/state}"
JAILER_BASE="${KNALLER_JAILER_BASE:-/srv/jailer}"

STATE="$STATE_DIR/$ID.json"

if [[ ! -f "$STATE" ]]; then
	echo "Missing sandbox state: $STATE" >&2
	exit 1
fi

UID_NUM="$(jq -r '.uid' "$STATE")"
GID_NUM="$(jq -r '.gid' "$STATE")"
NETNS="$(jq -r '.namespace' "$STATE")"

if [[ -z "$UID_NUM" || "$UID_NUM" == "null" ]]; then
	echo "State $STATE missing uid" >&2
	exit 1
fi
if [[ -z "$GID_NUM" || "$GID_NUM" == "null" ]]; then
	echo "State $STATE missing gid" >&2
	exit 1
fi
if [[ -z "$NETNS" || "$NETNS" == "null" ]]; then
	echo "State $STATE missing namespace" >&2
	exit 1
fi

exec /usr/local/bin/jailer \
	--id "$ID" \
	--exec-file /usr/local/bin/firecracker \
	--uid "$UID_NUM" \
	--gid "$GID_NUM" \
	--chroot-base-dir "$JAILER_BASE" \
	--netns "/run/netns/$NETNS" \
	--cgroup-version 2 \
	--resource-limit no-file=1024 \
	-- \
	--api-sock /run/firecracker.socket \
	--config-file /config.json
